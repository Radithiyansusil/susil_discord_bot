# Copy this file to .env and fill it in:   cp .env.example .env
# Never share your .env file or post it anywhere. It contains your bot's password.

# From the Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Any long random text. Generate one on the server with:  openssl rand -hex 24
LAVALINK_PASSWORD=paste-a-long-random-password-here

# Optional: your Discord server's ID. Makes slash commands appear instantly in that server.
# (Discord app > Settings > Advanced > Developer Mode ON, then right-click your server icon > Copy Server ID)
GUILD_ID=

# Optional tweaks
DEFAULT_VOLUME=60
IDLE_TIMEOUT_SECONDS=300
ALONE_TIMEOUT_SECONDS=60
